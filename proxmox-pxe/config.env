# Site settings for the Proxmox PXE installer. Edit, then run ./build.sh.

# Mac interface on the LAN (Wi-Fi is en0). The Mac's IP on this interface is
# baked into the iPXE binaries and installer image at build time; reserve it in
# the Spectrum app so it never changes, or rebuild after it does.
LAN_IFACE=en0
HTTP_PORT=8070

# Proxmox ISO (downloaded into cache/ by build.sh if missing).
PVE_ISO_NAME=proxmox-ve_9.2-1.iso
PVE_ISO_SHA256=4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c

# Node identity: <site><role><NN>, lowercase. Site "hn" (homenet), role "hv"
# (hypervisor) -> hnhv01, hnhv02, ... assigned in install order.
# DOMAIN is the private zone of z7x.org (dmz./public names stay separate).
HOST_PREFIX=hnhv
DOMAIN=int.z7x.org
TIMEZONE=America/Chicago
KEYBOARD=en-us
COUNTRY=us
MAILTO=root@localhost
