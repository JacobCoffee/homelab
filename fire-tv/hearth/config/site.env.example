# Your site: the devices, place and services this repo talks to.
# Copy to config/site.env (gitignored) and edit. Every script reads it; a variable already
# set in the environment wins over the file. Blank optional values hide that feature.

# Fire TV (ADB over Wi-Fi). Reserve its address in your router's DHCP.
FIRETV_HOST=192.168.1.50
FIRETV_ADB_PORT=5555

# The TV the stick is plugged into, for the remote bridge and Hearth's TV controls
# (tcl-tv/bridge). Leave blank if you don't run the bridge: Hearth hides its TV controls.
TV_HOST=

# Hearth's greeting and clock.
HEARTH_NAME=friend
HEARTH_TIMEZONE=America/New_York

# Weather (Open-Meteo, no key). Blank latitude hides the weather line.
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_LABEL=New York
WEATHER_UNITS=fahrenheit

# Optional services. Blank hides the widget.
GUILD_URL=https://sidequest-guild.com
KUMA_URL=
KUMA_STATUS_SLUG=home
ADGUARD_URL=
ADGUARD_USER=admin
ADGUARD_PASSWORD=
THEME_CATALOG_URL=

# The machine running teststack/ (local AdGuard, Uptime Kuma, theme catalog) for testing.
TESTSTACK_HOST=192.168.1.10

# Subject of the APK signing certificate made by tools/make-keystore.sh. It ships
# inside every APK you hand out, so keep it to what you'd publish.
KEYSTORE_DNAME=CN=Hearth
