<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The remote bridge (homekey/RemoteBridge.kt) wakes the stick before opening an app. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Development permission, granted over adb: `pm grant dev.jacobcoffee.hearth android.permission.READ_LOGS`. -->
    <uses-permission android:name="android.permission.READ_LOGS" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (Android 11+): Hearth must see every Leanback-launchable app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.amazon.tv.launcher" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/hearth_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/hearth_banner"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Same security posture as Homestead: canRetrieveWindowContent=false, no key
             filtering; only watches which package's window came to front. -->
        <service
            android:name=".homekey.HomeRedirectService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/homekey_accessibility_config" />
        </service>

        <!-- Own process so binding after `pm grant READ_LOGS` starts a fresh process that can
             read the log straight away. -->
        <service
            android:name=".homekey.HomeKeyWatcher"
            android:exported="false"
            android:process=":homekey" />

        <receiver
            android:name=".homekey.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Unlocks MediaSessionManager.getActiveSessions for Home's Now Playing strip; reads no
             notifications. Enabled by tools/install.sh (cmd notification allow_listener). -->
        <service
            android:name=".media.MediaListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Write-only; see tools/push-config.sh. -->
        <provider
            android:name=".config.ConfigProvider"
            android:authorities="dev.jacobcoffee.hearth.config"
            android:exported="true" />

    </application>
</manifest>
