<?xml version="1.0" encoding="utf-8"?>
<!--
  Same security posture as Homestead's HomeRedirectService: canRetrieveWindowContent is
  false (the service never reads window content, only which package's window came to
  front), and it watches only Amazon's launcher window so it cannot see or filter keys
  in any other app.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:packageNames="com.amazon.tv.launcher" />
