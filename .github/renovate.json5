{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Chicago)",
  ],
  // Nightly: anything due lands overnight, and automerged updates go straight to main.
  schedule: ["before 6am"],
  // config:recommended caps PRs at 2 an hour; that left updates queued for weeks.
  prHourlyLimit: 0,
  prConcurrentLimit: 20,
  // Flux HelmReleases/OCIRepositories, chart values images and plain manifests.
  flux: { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  "helm-values": { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  kubernetes: { managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"] },
  // Ansible pins annotated with `# renovate: datasource=… depName=…` on the line above.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^ansible/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\n[a-z0-9_]+: \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
  ],
  packageRules: [
    {
      // The cluster's images, charts and pinned tools update themselves: patch, minor and digest
      // bumps merge to main (no PR) once the release is 3 days old, and Flux rolls them out. A
      // failed HelmRelease upgrade rolls back on its own (kubernetes/flux/cluster/apps.yaml) and
      // FluxResourceNotReady alerts Discord. There's no CI, so there are no tests to wait for.
      matchFileNames: ["kubernetes/**", "ansible/**", "mise.toml"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      minimumReleaseAge: "3 days",
      // ghcr.io images often carry no release timestamp; don't hold those back forever.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // Talos image, talosctl and the cluster's Kubernetes move together; Talos decides
      // which Kubernetes versions are supported, and upgrading is a talosctl rollout, so these
      // open a PR and never merge on their own.
      groupName: "talos and kubernetes",
      matchDepNames: ["siderolabs/talos", "talosctl", "/siderolabs\\/talosctl/", "kubernetes/kubernetes", "kubectl", "/kubectl/"],
      automerge: false,
      labels: ["talos"],
    },
    {
      // Bootstrap pin in the talos role and the Flux HelmRelease must stay equal.
      groupName: "cilium",
      matchDepNames: ["cilium"],
    },
    {
      // Majors (Kuma 2, Radarr 7, Prowlarr 3, ...) change APIs or migrate databases: they open a
      // labelled PR (GitHub notifies you) and wait for you to read and merge it.
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["major"],
    },
    {
      // os-sso (opnsense role): not the official OPNsense plugin repo, and the sha256 pin next to
      // the version (opnsense_sso_sha256, no checksums file upstream) needs a human to re-verify
      // against the new release's GitHub-published digest -- a version bump alone would 404/fail
      // the checksum on the next `pkg add`, never silently install something unverified.
      matchDepNames: ["MaximeWewer/os-sso"],
      automerge: false,
      labels: ["opnsense-sso"],
    },
    {
      // terraform/cabotage pins a commit on cabotage/terraform#21, which is already ahead of
      // the newest tag (v1.9.3); only a later release is worth a PR.
      matchDepNames: ["github.com/cabotage/terraform"],
      allowedVersions: ">1.9.3",
    },
  ],
}
