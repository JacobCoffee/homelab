{
  "title": "Lab Overview",
  "uid": "lab-overview",
  "tags": ["lab", "home"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "default", "value": "default" },
        "hide": 0,
        "label": "Metrics"
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "default", "value": "default" },
        "hide": 0,
        "label": "Logs"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Kubernetes nodes up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(kube_node_status_condition{condition=\"Ready\", status=\"true\"})", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Pods running",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1)", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Scrape targets down",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } } },
      "targets": [{ "expr": "count(up == 0)", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Alerts firing",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } } },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"})", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Flux Kustomizations not Ready",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } } },
      "targets": [{ "expr": "count(gotk_resource_info{ready=\"False\", suspended!=\"true\"} == 1) or vector(0)", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Blackbox probes failing",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } } },
      "targets": [{ "expr": "count(probe_success == 0)", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "Proxmox host CPU",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "pve_cpu_usage_ratio{id=~\"node/.+\"}", "legendFormat": "{{id}}", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "Cluster CPU/memory (node_exporter)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "CPU busy", "refId": "A" },
        { "expr": "1 - avg(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "Mem used", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "title": "Log volume (all namespaces)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "${loki_datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (namespace) (count_over_time({namespace=~\".+\"}[1m]))", "legendFormat": "{{namespace}}", "refId": "A" }]
    }
  ],
  "links": [
    { "title": "Logs", "type": "dashboards", "tags": ["logs"], "asDropdown": false, "icon": "doc" },
    { "title": "Mimir", "type": "dashboards", "tags": ["mimir"], "asDropdown": false, "icon": "doc" },
    { "title": "Loki / Alloy", "type": "dashboards", "tags": ["loki", "alloy"], "asDropdown": false, "icon": "doc" }
  ]
}
