// Tailnet policy, managed by ansible/roles/tailscale_tailnet.
// site.yml overwrites edits made in the admin console: change this file instead.
{
	// Tags are what non-human devices log in as. Only admins (and keys they mint) can apply them.
	"tagOwners": {
		"tag:pve":    ["autogroup:admin"], // Proxmox hosts
		"tag:router": ["autogroup:admin"], // OPNsense, sharing the lab subnets
		// Cabotage's Tailscale operator (terraform/cabotage) logs in as tag:cabotage-operator and
		// tags the proxies it creates for tenant apps; tag:cabotage is its tenant-device prefix.
		"tag:cabotage-operator": ["autogroup:admin"],
		"tag:cabotage":          ["tag:cabotage-operator"],
	},

	// OPNsense's lab routes go live without a click in the admin console.
	"autoApprovers": {
		"routes": {
{% for cidr in tailscale_lab_routes %}
			"{{ cidr }}": ["tag:router"],
{% endfor %}
		},
	},

	"grants": [
		// You and anyone you invite reach every device and every lab subnet.
		// Tagged devices start nothing on their own; replies to your connections still flow.
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},
	],
}
