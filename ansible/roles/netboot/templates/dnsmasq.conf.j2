# Generated by Ansible (roles/netboot) for {{ netboot_hostname }} ({{ netboot_ip }}).
port=0
interface=eth0
bind-interfaces
dhcp-range={{ netboot_ip.split('.')[0:3] | join('.') }}.0,proxy,255.255.255.0
log-dhcp
enable-tftp
tftp-root={{ netboot_root }}/out/tftp
user=root
group=root
pxe-service=x86PC,"Proxmox auto-install (BIOS)",undionly.kpxe
pxe-service=x86-64_EFI,"Proxmox auto-install (UEFI)",ipxe.efi
pxe-service=BC_EFI,"Proxmox auto-install (UEFI)",ipxe.efi
